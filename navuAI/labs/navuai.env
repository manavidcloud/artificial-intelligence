# ─────────────────────────────────────────────────────────────────────────────
# navuAI Global Configuration Template
# INSTRUCTIONS: Copy this file to navuai.env, then fill in every value
#   cp navuai.env.template navuai.env
#   nano navuai.env
# ─────────────────────────────────────────────────────────────────────────────

# ── Azure Core ────────────────────────────────────────────────────────────────
AZURE_SUBSCRIPTION_ID="3ab4323c-e2ad-449e-ab64-565b17412d8f"
AZURE_LOCATION="centralindia"
RESOURCE_GROUP="navuai-rg"

# ── AKS Cluster ───────────────────────────────────────────────────────────────
AKS_CLUSTER_NAME="navuai-aks"
AKS_NODE_VM_SIZE="Standard_D2s_v3"
AKS_NODE_COUNT_MIN=1
AKS_NODE_COUNT_MAX=2

# ── Container Registry ────────────────────────────────────────────────────────
ACR_NAME="navuairegistry"          # globally unique, lowercase only, no dashes

# ── Key Vault ─────────────────────────────────────────────────────────────────
KEYVAULT_NAME="navuai-kv"          # globally unique

# ── Networking ────────────────────────────────────────────────────────────────
VNET_NAME="navuai-vnet"
VNET_CIDR="10.0.0.0/16"
AKS_SUBNET_CIDR="10.0.1.0/24"
GPU_SUBNET_CIDR="10.0.2.0/24"
PE_SUBNET_CIDR="10.0.3.0/24"
AKS_SERVICE_CIDR="10.96.0.0/16"   # must NOT overlap VNet (10.0.0.0/16)
AKS_DNS_SERVICE_IP="10.96.0.10"   # must be within AKS_SERVICE_CIDR

# ── GPU VM (self-hosted LLMs) ─────────────────────────────────────────────────
GPU_VM_NAME="navuai-gpu-vm"
GPU_VM_SIZE="Standard_NC4as_T4_v3" # dev: NC4as_T4_v3 (India available)  |  prod: Standard_NC24ads_A100_v4
GPU_VM_ADMIN_USER="navuaiadmin"
GPU_VM_SSH_KEY_PATH="$HOME/.ssh/navuai_gpu_rsa"
SKIP_GPU_VM=true                   # set false only after GPU quota is approved in Azure portal

# ── DNS / Domain ──────────────────────────────────────────────────────────────
#paid domain - manmas.online 
DOMAIN="manmas.online"
CHAT_SUBDOMAIN="chat"              # → chat.manmas.online
API_SUBDOMAIN="api"                # → api.manmas.online
LETSENCRYPT_EMAIL="mohamadabdulnavidcloud@gmail.com"

# ── LLM Provider Keys (fill only what you have) ───────────────────────────────
OPENAI_API_KEY=""

AZURE_OPENAI_KEY="BtABPcr0Tc0sOAU1hB43wZcsGL89E1FFhAwFmWvzTLY014oBjSQlJQQJ99CEACYeBjFXJ3w3AAABACOGJ5Ap"
AZURE_OPENAI_ENDPOINT="https://navuai-foundry-f6b46.openai.azure.com/"
AZURE_OPENAI_API_VERSION="2024-08-01-preview"
FOUNDRY_RESOURCE_NAME="navuai-foundry"
FOUNDRY_LOCATION="southindia"      # trying india region; fallback to eastus if model unavailable
FOUNDRY_MODEL_NAME="gpt-4.1-nano"
FOUNDRY_MODEL_VERSION="2025-04-14" # confirmed working in finops project
FOUNDRY_DEPLOYMENT_NAME="gpt-4.1-nano"
FOUNDRY_CAPACITY=10               # tokens-per-minute in thousands (10 = 10K TPM, free tier safe)

AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"

VERTEX_PROJECT=""
VERTEX_LOCATION="us-central1"

# ── Billing ───────────────────────────────────────────────────────────────────
MONTHLY_USER_BUDGET_USD="40"
ALERT_THRESHOLD_PERCENT="80"

# ── Observability ─────────────────────────────────────────────────────────────
LANGFUSE_SECRET_KEY="changeme-langfuse-secret"
LANGFUSE_PUBLIC_KEY="changeme-langfuse-public"
GRAFANA_ADMIN_PASSWORD="changeme-grafana"

# ── GitHub (for CI/CD phase) ──────────────────────────────────────────────────
GITHUB_ORG=""
GITHUB_REPO="navuAI"
