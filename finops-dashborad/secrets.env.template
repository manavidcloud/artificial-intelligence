# =============================================================================
# FinOps Platform — Secrets Template
# 1. Copy:  cp secrets.env.template secrets.env
# 2. Fill all values (setup.sh prints them at the end)
# 3. Run:   bash 1-infrastructure/scripts/apply-secrets.sh
# NEVER commit secrets.env to git — it is listed in .gitignore
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_HOST=finops-pgflex.postgres.database.azure.com
DB_NAME=finops-db
DB_USER=pgadmin
DB_PASSWORD=<postgres-admin-password-set-in-setup.sh>

# ── Azure OpenAI ──────────────────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://<your-openai-resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# Leave blank to use Workload Identity (recommended). Set only if you need key-based auth.
AZURE_OPENAI_API_KEY=

# ── Managed Identity ──────────────────────────────────────────────────────────
# az identity show --name mi-finops-prod --resource-group rg-finops-prod-core --query clientId -o tsv
MI_CLIENT_ID=<managed-identity-client-id>

# ── Subscriptions ─────────────────────────────────────────────────────────────
# Comma-separated if multiple
AZURE_SUBSCRIPTION_IDS=<your-subscription-uuid>

# ── Entra ID / SSO (optional) ─────────────────────────────────────────────────
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# ── LangSmith (optional — AI agent tracing) ───────────────────────────────────
LANGSMITH_API_KEY=

# ── Email Notifications (optional) ───────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_RECIPIENTS=
