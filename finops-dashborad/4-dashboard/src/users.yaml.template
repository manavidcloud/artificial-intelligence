# =============================================================================
# FinOps Dashboard — User Credentials Template
# =============================================================================
# 1. Copy:   cp users.yaml.template users.yaml
# 2. Update passwords (bcrypt hashes are auto-generated on first login)
# 3. NEVER commit users.yaml — it is listed in .gitignore
#
# Roles:
#   admin  — full access including Settings, manual sync, and alert triggers
#   viewer — read-only access to all dashboard pages
#
# IMPORTANT: The key under "users:" is the LOGIN USERNAME (what you type in the
#            Username field). The "name:" field is only the display name shown
#            after login — it is NOT used for authentication.
#
#   users:
#     admin        ← login username
#       name: "Administrator"  ← display name only, not used for login
# =============================================================================

users:
  admin:
    password: "changeme-use-strong-password"   # replaced with bcrypt hash on first login
    name: "Administrator"                      # display name only — login username is "admin"
    role: "admin"

  viewer:
    password: "viewer-changeme"                # replaced with bcrypt hash on first login
    name: "Viewer User"
    role: "viewer"

# Add more users following the same structure:
# username:
#   password: "plaintext-or-bcrypt-hash"
#   name: "Display Name"
#   role: "admin" | "viewer" 
